# Cameroon Catering Service — environment
#
# Copy to .env.local and fill in from the Supabase dashboard. Never commit
# .env.local, and never paste key values into chat or an issue.
#
# There is no backend yet, so the application runs without any of these: the
# data layer falls back to the seed data in src/data when the Supabase
# variables are absent. Setting them is what switches it over.

# The deployed origin. Needed as soon as auth exists, because it builds the
# links in confirmation and password-recovery emails — left as localhost, those
# links only work on the machine that sent them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. Both of these are safe in the browser: the anon key is
# constrained by the row-level policies in supabase/migrations/0007.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key bypasses every row-level policy in the database — it is
# a database password. It must never be prefixed NEXT_PUBLIC_, never reach the
# browser, and never appear in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Not used yet -----------------------------------------------------------
# Payment providers. Server-side only: a client that can name its own amount
# can name a smaller one. See Documentation/PAYMENTS.md.
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=
# ORANGE_CLIENT_ID=
# ORANGE_CLIENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# Notifications — a quote request nobody is told about is not a quote request.
# WHATSAPP_API_TOKEN=
# SMS_PROVIDER_KEY=
